{
  "name": "grimstroke",
  "version": "0.6.1",
  "description": "The grimstroke core: notebooks and boards as data, the / box that understands what is typed, the day, reminders and repositories, served as an API. A face draws it.",
  "author": "Atur Dana",
  "license": "MPL-2.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js"
  },
  "bin": {
    "grimstroke": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node --import ./tools/register.mjs tools/build.ts",
    "build:dev": "node --import ./tools/register.mjs tools/build.ts --dev",
    "watch": "node --import ./tools/register.mjs tools/build.ts --dev --watch",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm build",
    "train": "node --import ./tools/register.mjs tools/train-shape.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.0",
    "@types/node": "^24.10.0",
    "esbuild": "^0.25.10",
    "playwright": "^1.62.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
